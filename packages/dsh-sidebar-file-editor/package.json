{
  "name": "dsh-sidebar-file-editor",
  "version": "0.2.0",
  "description": "Edit workspace text files in the DeepSeek Harness right sidebar with CodeMirror, Prettier formatting, basic completion, and Save/Undo/Redo shortcuts.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "file-editor",
    "sidebar",
    "workspace",
    "codemirror",
    "prettier",
    "autocomplete"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "client.format-*.js"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-files"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "build:client": "node scripts/build-editor.mjs",
    "prepack": "node scripts/build-editor.mjs"
  }
}
